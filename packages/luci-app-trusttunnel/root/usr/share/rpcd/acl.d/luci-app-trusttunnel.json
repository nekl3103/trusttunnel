{
	"luci-app-trusttunnel": {
		"description": "Grant access to TrustTunnel configuration and diagnostics",
		"read": {
			"ubus": {
				"luci-rpc": [ "getHostHints" ],
				"luci.trusttunnel": [
					"service_result", "status", "multi_status", "ping", "probe", "check_domain", "catalog", "geosite_catalog", "log", "versions", "diagnose", "speedtest_status"
				]
			},
			"uci": [ "trusttunnel" ]
		},
		"write": {
			"ubus": {
				"luci.trusttunnel": [ "service", "import_config", "speedtest_start", "speedtest_stop", "multi_override", "secret_set" ]
			},
			"uci": [ "trusttunnel" ]
		}
	}
}
