#!/bin/sh
set -u
LIBDIR=${TT_LIBDIR:-/usr/libexec/trusttunnel}
OUTDIR=${TT_MULTI_OUT:-/var/etc/trusttunnel/multi}
failure_interval="${1:-10}"
stable_interval="${2:-300}"
case "$failure_interval" in ''|*[!0-9]*) failure_interval=10;; esac
case "$stable_interval" in ''|*[!0-9]*) stable_interval=300;; esac
[ "$failure_interval" -ge 5 ] || failure_interval=5
[ "$stable_interval" -ge 60 ] || stable_interval=60
sleep 5
while :; do
	"$LIBDIR/multi-manager" select \
		|| logger -t trusttunnel-multi 'health refresh failed'
	if awk -F '\t' '$2=="down" || $7+0>0 { failed=1 } END { exit !failed }' "$OUTDIR/health.tsv" 2>/dev/null ||
	   grep -q "$(printf '\t-\t')" "$OUTDIR/selection.tsv" 2>/dev/null; then
		delay=$failure_interval
	else
		delay=$stable_interval
	fi
	sleep "$delay"
done
