#!/bin/sh
set -e

DIR=${TT_SECRET_DIR:-/etc/trusttunnel/secrets}
cmd=${1:-}; section=${2:-}
safe=$(printf '%s' "$section" | tr -cd 'A-Za-z0-9_')
[ -n "$safe" ] && [ "$safe" = "$section" ] || { echo 'invalid server section' >&2; exit 2; }
file=$DIR/$safe.password

case "$cmd" in
	get) [ -f "$file" ] && cat "$file" ;;
	set)
		mkdir -p "$DIR"; chmod 700 "$DIR"; umask 077
		value=$(cat)
		[ -n "$value" ] || { echo 'password is empty' >&2; exit 2; }
		printf '%s' "$value" > "$file.new"; chmod 600 "$file.new"; mv "$file.new" "$file"
		;;
	migrate)
		value=$(uci -q get "trusttunnel.$section.password" 2>/dev/null || true)
		if [ -n "$value" ]; then
			printf '%s' "$value" | "$0" set "$section"
			uci -q delete "trusttunnel.$section.password"; uci -q commit trusttunnel
		fi
		;;
	has) [ -s "$file" ] ;;
	*) echo 'usage: secret-store {get|set|migrate|has} <server-section>' >&2; exit 2 ;;
esac
