#!/bin/sh
# Generate one TrustTunnel client config from a UCI `server` section.
set -e

# OpenWrt functions are absent on the development host and replaced by tests.
# shellcheck disable=SC1090
. "${TT_FUNCTIONS:-/lib/functions.sh}"

section="${1:?usage: multi-gen-config <server-section>}"
config_load trusttunnel

get() { config_get _v "$section" "$1" "${2:-}"; printf '%s' "$_v"; }
bool() { config_get_bool _v "$section" "$1" "${2:-0}"; [ "$_v" = 1 ] && printf true || printf false; }
esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
array_items=""
add_array_item() {
	_v=$(esc "$1")
	[ -z "$array_items" ] || array_items="$array_items, "
	array_items="$array_items\"$_v\""
}
array_opt() {
	array_items=""
	config_list_foreach "$section" "$1" add_array_item
	printf '[%s]' "$array_items"
}

hostname=$(get hostname)
username=$(get username)
password=$("${TT_SECRET_STORE:-/usr/libexec/trusttunnel/secret-store}" get "$section" 2>/dev/null || true)
[ -n "$password" ] || password=$(get password)
[ -n "$hostname" ] || { echo "multi-gen-config: $section has no hostname" >&2; exit 1; }
[ -n "$username" ] || { echo "multi-gen-config: $section has no username" >&2; exit 1; }
[ -n "$password" ] || { echo "multi-gen-config: $section has no password" >&2; exit 1; }
addresses=$(array_opt address)
[ "$addresses" != "[]" ] || { echo "multi-gen-config: $section has no address" >&2; exit 1; }

config_get cert "$section" certificate
emit_cert() {
	if [ -n "${cert:-}" ]; then
		printf "certificate = '''\n%s\n'''" "$cert"
	else
		printf 'certificate = ""'
	fi
}

config_get loglevel main log_level info
config_get mtu network mtu 1350
case "$mtu" in ''|*[!0-9]*) mtu=1350;; esac

# Assigned indirectly by config_get from /lib/functions.sh.
# shellcheck disable=SC2154
cat <<EOF
# Generated by luci-app-trusttunnel multi-server mode.
loglevel = "$(esc "$loglevel")"
vpn_mode = "general"
killswitch_enabled = false
post_quantum_group_enabled = $(bool post_quantum 1)
exclusions_tcp_early_ack_enabled = true
exclusions_preresolve_enabled = true
exclusions = []

[endpoint]
hostname = "$(esc "$hostname")"
addresses = $addresses
custom_sni = "$(esc "$(get custom_sni)")"
has_ipv6 = $(bool has_ipv6 1)
username = "$(esc "$username")"
password = "$(esc "$password")"
client_random = "$(esc "$(get client_random)")"
skip_verification = $(bool skip_verification 0)
$(emit_cert)
upstream_protocol = "$(esc "$(get protocol http2)")"
anti_dpi = $(bool anti_dpi 0)
dns_upstreams = $(array_opt dns_upstream)

[listener.tun]
included_routes = []
excluded_routes = []
mtu_size = $mtu
change_system_dns = false
EOF
