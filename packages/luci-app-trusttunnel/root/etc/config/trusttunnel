config main 'main'
	option enabled '0'
	option multi_server '0'
	option health_interval '10'
	option stable_health_interval '300'
	option switch_threshold '15'
	option switch_cooldown '120'
	option mode 'selective'
	option full_exclude_lists '0'
	option log_level 'info'
	option device_routing '0'

config endpoint 'endpoint'
	option hostname ''
	option username ''
	option password ''
	option protocol 'http2'
	option anti_dpi '0'
	option post_quantum '1'
	option skip_verification '0'
	option certificate ''
	option has_ipv6 '1'
	option custom_sni ''
	option client_random ''

config network 'network'
	option mtu '1350'
	option early_ack '1'
	option preresolve '1'
	option preresolve_max '50'
	option scannable_ports '443,80,8080,8008,853'
	option tcp_recv_buf '0'
	option tcp_send_buf '0'
	option table '880'
	option fwmark '0x9527'
	option blackhole_on_down '1'
	option include_router_traffic '0'
	option intercept_dns '0'
	option list_dns 'plain'
	option list_resolver '1.1.1.1'
	option list_doh_url ''
	option list_doh_port '5460'
	option doh_network '0'
	option lan_devices ''

config lists 'lists'
	option auto_update '1'
	option update_interval 'daily'

config domains 'domains'

# Multi-server mode adds named `server` and `group` sections. They are created
# from LuCI; examples:
# config server 'finland'
#     option enabled '1'
#     option name 'Finland'
#     option hostname 'vpn.example.com'
#     list address '203.0.113.10:443'
#     option username 'user'
#     option password 'secret'
#
# config group 'video'
#     option enabled '1'
#     option name 'Video'
#     option strategy 'auto'
#     list pool 'finland'
#     list domain 'youtube.com'
#
# Optional per-device routing. When main.device_routing is enabled, only the
# listed device/group pairs use TrustTunnel; all other traffic stays direct.
# config device 'phone'
#     option enabled '1'
#     option name 'Phone'
#     option match '192.168.1.20'
#     list group 'youtube'
